# Dev pages at the repository root only. handsontable/.gitignore covers the core
# package's root (/dev*.html, /dev*.js, and /dev*.ts); a dev page in any other
# package shows in `git status`. Without the slash these matched at every depth and
# kept new sources such as handsontable/src/**/dev*.js out of it. Pinned by
# scripts/__tests__/gitignore-scope.test.mjs.
/dev*.html
/dev*.js
npm-debug.log

.nx/
.parcel-cache/
# Both spellings on purpose. The trailing slash matches directories only, so in a
# worktree whose node_modules is a SYMLINK git would report it as untracked and
# `git add -A` would commit a link holding an absolute machine-local path.
node_modules/
node_modules
docs/tests/test-artifacts/
docs/tests/.env
docs/.env
# Local credentials for any package (R2 keys for the visual suite, etc.).
.env
.env.local
**/.env

*.nupkg

# Playwright screenshots (created by Claude Code sessions)
/*.png
/docs/*.png
# Added by code-review-graph
.code-review-graph/

# QA overhaul planning scaffold — local-only, never committed. Durable rules
# live in the committed structure (AGENTS.md, .ai/, .claude/skills/, ESLint
# rules, hooks); decisions are recorded in ClickUp (DEV-2055).
quality/

# StrykerJS mutation-testing artifacts (evals — DEV-2061)
.stryker-tmp/
reports/mutation/
