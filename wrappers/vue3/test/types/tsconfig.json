{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "baseUrl": "./",
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2017", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": [],
    // The files under test are all `.d.ts`, so `skipLibCheck` must stay off: with it on, an
    // emitted declaration naming a type `vue-tsc` could not express would ship broken and this
    // suite would stay green. Matches core's `handsontable/test/types/tsconfig.json`.
    "skipLibCheck": false
  },
  "include": [
    "./**/*.types.ts"
  ]
}
