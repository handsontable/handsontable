    "copyfiles": "^2.4.1",
    "http-server": "^14.1.1",
    "jasmine": "3.7.0",
    "jasmine-console-reporter": "3.1.0",
    "puppeteer": "^25.12.0",
    "react-router-dom": "^6.22.3",
    "typescript": "^5.0.2",
    "vite": "^6.4.3"
