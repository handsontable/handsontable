{
  "name": "handsontable-tests",
  "private": true,
  "type": "module",
  "description": "Consolidated Playwright test package (functional e2e + visual). See tests/README.md.",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e-main",
    "report": "playwright show-report",
    "lint": "eslint --ext .js,.mjs,.ts a11y e2e fixtures reporters lib scripts",
    "test:a11y": "playwright test --config playwright.a11y.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "catalog:",
    "@typescript-eslint/parser": "8.61.0",
    "axe-core": "4.14.0",
    "eslint": "8.57.1",
    "exceljs": "4.4.0",
    "hyperformula": "3.3.0",
    "hyperformula-ui": "0.3.6"
  }
}
