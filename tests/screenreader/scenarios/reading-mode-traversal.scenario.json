{
  "schema": 1,
  "id": "reading-mode-traversal",
  "surface": "Reading mode through a grid with a frozen row and column: every cell read once, in row-major order, with no second copy from the overlay clones.",
  "group": "reading",
  "page": "grid",
  "start": "page",
  "criteria": ["1.3.1", "1.3.2", "4.1.2"],
  "setup": [{"updateSettings": {"maxRows": 3, "fixedRowsTop": 1, "fixedColumnsStart": 1}}, {"sentinels": true}, {"focus": "[data-sr-sentinel=\"before\"]"}],
  "traversal": {"from": "to-grid", "to": "past-grid", "items": [["A1", "A 1"], ["B1", "B 1"], ["C1", "C 1"], ["A2", "A 2"], ["B2", "B 2"], ["C2", "C 2"], ["A3", "A 3"], ["B3", "B 3"], ["C3", "C 3"]]},
  "steps": [
    {
      "id": "to-grid",
      "action": {"read": "next"},
      "expect": [["table", "tree grid", "grid"]],
      "note": "From the control before the grid, the reading cursor moves on to the grid, which a reader announces by its role."
    },
    {
      "id": "enter-grid",
      "action": {"read": "in"},
      "expect": [],
      "unsupported": {"nvda": "NVDA has no interaction level: browse mode reads into a table without entering it, so there is nothing to enter."},
      "note": "VoiceOver interacts with the grid (VO-Shift-Down), the way its user reads a table cell by cell."
    },
    {
      "id": "read-1",
      "action": {"read": "next"},
      "expect": [],
      "note": "Each read moves one item on: NVDA reads one line of its browse-mode buffer (a cell with its row, column and the headers that changed), VoiceOver one cell of the row it is in, wrapping to the next row. The reads are enough for both to leave the grid; a read past the end repeats the last line (NVDA) or says nothing (VoiceOver)."
    },
